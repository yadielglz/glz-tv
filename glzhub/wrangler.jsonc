{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glzhub",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "routes": [
    {
      "pattern": "glzhub.glztech.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "EPG_BUCKET",
      "bucket_name": "glzhub-epg"
    }
  ],
  "observability": {
    "enabled": true
  }
}
